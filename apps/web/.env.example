# Copy to .env.local and change the values. Never commit .env.local.

# Password for the kitchen console at /console (required in production).
CONSOLE_PASSWORD=change-me

# Secret used to sign order verify codes and console sessions (32+ random characters).
ORDER_SIGNING_SECRET=replace-with-a-long-random-string

# Public base URL used in tracking links inside WhatsApp messages.
PUBLIC_BASE_URL=http://localhost:3000
