# Copy to .env.local and change the values. Never commit .env.local.

# Password for the kitchen console at /console (required in production, 6+ characters).
CONSOLE_PASSWORD=change-me

# Optional. Secret that signs order verify codes and console sessions (32+ random characters).
# If unset in production, one is generated on first start and stored in FIELDCUT_DATA_DIR.
ORDER_SIGNING_SECRET=replace-with-a-long-random-string

# Optional. Public base URL used in tracking links inside WhatsApp messages.
# Falls back to RAILWAY_PUBLIC_DOMAIN on Railway, then to the request's host.
PUBLIC_BASE_URL=http://localhost:3000

# Optional. Folder for the SQLite database. Defaults to apps/web/.data; set to a volume in production.
# FIELDCUT_DATA_DIR=/data
