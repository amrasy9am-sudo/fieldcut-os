{
  "name": "fieldcut-os",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:reset": "node -e \"require('fs').rmSync('apps/web/.data',{recursive:true,force:true})\"",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "packageManager": "pnpm@12.15.0"
}
